// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ServiceCategory {
  SKIN_AND_FACIALS
  ADVANCED_TREATMENTS
  BROWS_LASHES_MAKEUP
  HAIR_AND_COLOR
  TEETH_WHITENING
  VIP_MEMBERSHIPS
}

model Service {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  category    ServiceCategory
  description String
  duration    Int             // minutes
  price       Float           // base price in dollars
  isActive    Boolean         @default(true)
  isFeatured  Boolean         @default(false)
  addOns      String?         // JSON string of add-ons
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookings    Booking[]
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String
  address   String?
  city      String?
  zipCode   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]

  @@index([email])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  DEPOSIT_PAID
  PAID
  REFUNDED
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique

  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])

  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])

  scheduledDate   DateTime
  scheduledTime   String        // Format: "14:00"
  duration        Int           // minutes (includes buffer)

  address         String
  city            String
  zipCode         String
  notes           String?

  status          BookingStatus   @default(PENDING)
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentAmount   Float?
  stripePaymentId String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scheduledDate])
  @@index([status])
  @@index([clientId])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model Availability {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 0 = Sunday, 6 = Saturday
  startTime   String   // Format: "09:00"
  endTime     String   // Format: "18:00"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dayOfWeek])
}

model BlackoutDate {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}
